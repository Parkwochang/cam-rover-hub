LISTEN_ADDR=127.0.0.1:8080
ROVER_ADDR=cam-rover.local
ROVER_API_TOKEN=REPLACE_WITH_FIRMWARE_TOKEN
DB_PATH=/var/lib/cam-rover-hub/rover.db
MAP_DIR=/var/lib/cam-rover-hub/maps
AP_INTERFACE=wlan0
AP_PROFILE=cam-rover
VISION_WORKER=/opt/cam-rover-hub/vision/build/rover-vision
CAMERA_CONFIG=/etc/cam-rover-hub/camera.yaml
SLAM_VOCABULARY=/opt/cam-rover-hub/orb_vocab.fbow
REQUIRE_TAILSCALE_IDENTITY=1
TAILSCALE_ALLOWED_LOGIN=owner@example.com
AUTO_ENABLED=0
